#include <iostream>
#include <vector>
#include <cstdlib>
#include <ctime>
using namespace std;

int partition(vector<int>& a, int low, int high) {
    int randomIndex = low + rand() % (high - low + 1);

    swap(a[randomIndex], a[high]);

    int pivot = a[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        if (a[j] <= pivot) {
            i++;
            swap(a[i], a[j]);
        }
    }

    swap(a[i + 1], a[high]);

    return i + 1;
}

int randomizedSelect(vector<int>& a, int low, int high, int i) {
    if (low == high)
        return a[low];

    int q = partition(a, low, high);

    int k = q - low + 1;

    if (i == k)
        return a[q];

    if (i < k)
        return randomizedSelect(a, low, q - 1, i);

    return randomizedSelect(a, q + 1, high, i - k);
}

int main() {
    srand(time(0));

    int n;
    cout << "Enter number of elements: ";
    cin >> n;

    vector<int> a(n);

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    int i;
    cout << "Enter i (i-th smallest): ";
    cin >> i;

    if (i < 1 || i > n) {
        cout << "Invalid value of i." << endl;
        return 0;
    }

    int result = randomizedSelect(a, 0, n - 1, i);

    cout << i << "-th smallest element = " << result << endl;

    return 0;
}
